# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_USER_DB=users
MONGODB_USER_COLLECTION=users
MONGODB_TENANT_COLLECTION=tenants
MONGODB_SERVICE_COLLECTION=services
MONGODB_BOOKING_COLLECTION=bookings
MONGODB_CHAT_COLLECTION=conversations

# JWT
JWT_SECRET_KEY=sua_chave_secreta_aqui
JWT_SECRET=seu_jwt_secret_aqui

# AI Configuration (Chat IA)
# ==========================================
# PROVIDER OPTIONS:
#   - groq:     Groq API (free, fast) - RECOMMENDED
#   - openai:   OpenAI API (paid, use OPENAI_API_KEY)
#   - ollama:  Local Ollama (requires Ollama installed)
#   - fallback: Built-in keyword-based responses
AI_PROVIDER=groq

# Groq API (FREE - no credit card required)
# Get your free key at: https://console.groq.com
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile, qwen3-32b
GROQ_API_KEY=

# OpenAI API (paid)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=

# Ollama (local - for self-hosted AI)
# Default: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1