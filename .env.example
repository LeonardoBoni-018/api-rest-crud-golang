# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_USER_DB=users
MONGODB_USER_COLLECTION=users
MONGODB_TENANT_COLLECTION=tenants
MONGODB_SERVICE_COLLECTION=services
MONGODB_BOOKING_COLLECTION=bookings
MONGODB_CHAT_COLLECTION=conversations
MONGODB_SUBSCRIPTION_COLLECTION=subscriptions
MONGODB_PAYMENT_COLLECTION=payments

# JWT
JWT_SECRET_KEY=sua_chave_secreta_aqui
JWT_SECRET=seu_jwt_secret_aqui

# AI Configuration (Chat IA)
# ==========================================
# PROVIDER OPTIONS:
#   - groq:     Groq API (free, fast) - RECOMMENDED
#   - openai:   OpenAI API (paid, use OPENAI_API_KEY)
#   - ollama:  Local Ollama (requires Ollama installed)
#   - fallback: Built-in keyword-based responses
AI_PROVIDER=groq

# Groq API (FREE - no credit card required)
# Get your free key at: https://console.groq.com
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile, qwen3-32b
GROQ_API_KEY=

# OpenAI API (paid)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=

# Ollama (local - for self-hosted AI)
# Default: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# EMAIL NOTIFICATIONS (Brevo)
# ==========================================
# Provider: brevo (free - 300 emails/day)
# Other options: mailgun, mailtrap
EMAIL_PROVIDER=brevo

# Brevo API (FREE - no credit card required)
# Get your free key at: https://app.brevo.com
# Sign up with your Google account or email
BREVO_API_KEY=

# Sender email address (must be verified in Brevo)
BREVO_FROM_EMAIL=noreply@seudominio.com.br

# Sender name (displayed in email)
BREVO_FROM_NAME=Sistema de Agendamentos

# PAYMENTS (Stripe)
# ==========================================
# Provider: stripe
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (configure in Stripe Dashboard)
# These must be created in Stripe Dashboard and pasted here
STRIPE_PRICE_BASIC_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_ENTERPRISE_ID=